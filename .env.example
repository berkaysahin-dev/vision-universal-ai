# ==============================================================================
# Vision Universal AI - Environment Variables Template
# One SDK. Every AI. by Shaz Vision (https://shazvision.com)
# ==============================================================================
# Instructions: Copy this file to .env and insert your personal API keys.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Get at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude API Key (Get at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq Cloud API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=

# DeepSeek API Key (Get at: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# OpenRouter API Key (Get at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Mistral AI API Key (Get at: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Local Ollama Host (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Default Provider Selection (optional: gemini | openai | anthropic | groq | deepseek | openrouter | ollama | mistral)
DEFAULT_PROVIDER=gemini
